<odoo>
    <template id="report_purchaseorder_document_dynamic_terms_conditions" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//p[@t-field='o.notes']" position="before">
            <div class="terms-conditions mt-4">
                <h3>Terms and Conditions</h3>
                <p>
                    These are the general terms and conditions for the purchase order.
                    <br/>
                    Vendor: <span t-field="o.partner_id.name"/>
                    <br/>
                    Vendor VAT: <span t-field="o.partner_id.vat"/>
                    <br/>
                    Vendor Company Registry: <span t-field="o.partner_id.company_registry"/>
                    <br/>
                    Vendor Address: 
                    <span t-field="o.partner_id.street"/>
                    <br/>
                    <span t-field="o.partner_id.city"/>
                    <br/>
                    <span t-field="o.partner_id.zip"/>
                    <br/>
                    <span t-field="o.partner_id.country_id.name"/>
                    <br/>
                    Please review the terms and conditions carefully.
                </p>
            </div>
        </xpath>
    </template>
</odoo>